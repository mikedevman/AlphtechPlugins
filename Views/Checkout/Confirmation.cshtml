@model AlphtechPlugins.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <div class="success-icon"><i class="bi bi-check-circle-fill"></i></div>
        <h2 class="fw-bold mt-3">Order Confirmed!</h2>
        <p class="text-secondary">Your plugins are ready to download.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="order-card mb-4">
                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <small class="text-secondary">Order ID</small>
                        <p class="fw-bold mb-0">@Model.OrderId</p>
                    </div>
                    <div class="text-end">
                        <small class="text-secondary">Date</small>
                        <p class="fw-bold mb-0">@Model.OrderDate.ToString("MMM dd, yyyy HH:mm UTC")</p>
                    </div>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <small class="text-secondary">Customer</small>
                        <p class="fw-bold mb-0">@Model.CustomerName</p>
                    </div>
                    <div class="text-end">
                        <small class="text-secondary">Email</small>
                        <p class="fw-bold mb-0">@Model.CustomerEmail</p>
                    </div>
                </div>
                <div class="mb-3">
                    <small class="text-secondary">Platform</small>
                    <p class="fw-bold mb-0">@Model.Platform</p>
                </div>
                <hr class="border-secondary">
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">Total Charged</span>
                    <span class="fw-bold text-success fs-4">$@Model.Total.ToString("F2")</span>
                </div>
            </div>

            <h4 class="fw-bold mb-3">Your License Keys</h4>
            @foreach (var item in Model.Items)
            {
                <div class="order-card mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="fw-bold mb-1">@item.ProductName</h6>
                            <span class="text-success">@(item.Price == 0 ? "FREE" : $"${item.Price:F2}")</span>
                        </div>
                        <div class="text-end">
                            <small class="text-secondary d-block mb-1">License Key</small>
                            <span class="license-key">@item.LicenseKey</span>
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-accent" onclick="downloadLicense('@item.ProductName', '@Model.Platform', '@item.LicenseKey', '@Model.CustomerName', '@Model.CustomerEmail')">
                            <i class="bi bi-download"></i> Download License & Package
                        </button>
                        <a href="/" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark-text"></i> Store Catalog</a>
                    </div>
                </div>
            }

            <div class="text-center mt-4">
                <a href="/" class="btn btn-outline-info"><i class="bi bi-arrow-left"></i> Back to Store</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function downloadLicense(product, platform, key, name, email) {
    const content = `==================================================\nALPHTECH AUDIO TECHNOLOGIES - OFFICIAL LICENSE\n==================================================\nProduct:       ${product}\nPlatform:      ${platform}\nLicense Key:   ${key}\nLicensed To:   ${name} (${email})\nStatus:        ACTIVATED (PROMOTIONAL FREE LICENSE)\nIssue Date:    ${new Date().toISOString()}\n==================================================\n\nACTIVATION INSTRUCTIONS:\n1. Install the VST3/AU component into your system audio plugin directory.\n2. Open your DAW (AlphtechWebDAW, Ableton, FL Studio, Reaper, etc.).\n3. Insert ${product} on an audio track.\n4. Paste the license key above into the activation prompt.\n\nSupport: https://alphtech.io\n`;
    const blob = new Blob([content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Alphtech-${product.replace(/\s+/g, '')}-License.txt`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}
</script>
}
