@model AlphtechPlugins.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container my-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-bag-check text-info"></i> Checkout</h2>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="checkout-form">
                <h5 class="fw-bold mb-3">Your Details</h5>
                <form method="post" action="/Checkout/Process">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="Name" value="@Model.Name" class="form-control" placeholder="Enter your name" />
                        <span class="text-danger">@Html.ValidationMessage("Name")</span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="Email" value="@Model.Email" class="form-control" placeholder="you@example.com" />
                        <span class="text-danger">@Html.ValidationMessage("Email")</span>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Target Platform</label>
                        <select name="Platform" class="form-select">
                            <option value="Windows" selected="@(Model.Platform == "Windows")">Windows (x64)</option>
                            <option value="macOS" selected="@(Model.Platform == "macOS")">macOS (Apple Silicon / Intel)</option>
                        </select>
                    </div>
                    <div class="p-3 rounded mb-4" style="background:#111;border:1px solid var(--border-color);">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">@Model.CartItems.Count plugin(s)</span>
                            <span class="text-success fw-bold">$@Model.Total.ToString("F2")</span>
                        </div>
                        <small class="text-secondary"><i class="bi bi-shield-check"></i> No credit card required</small>
                    </div>
                    <button type="submit" class="btn btn-accent btn-lg w-100">
                        <i class="bi bi-lightning-charge-fill"></i> Complete Order — $@Model.Total.ToString("F2")
                    </button>
                </form>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="cart-summary">
                <h5 class="fw-bold mb-3">Your Plugins</h5>
                @foreach (var item in Model.CartItems)
                {
                    <div class="d-flex justify-content-between py-2 border-bottom border-secondary">
                        <span>@item.ProductName</span>
                        <span class="text-success">@(item.Price == 0 ? "FREE" : $"${item.Price:F2}")</span>
                    </div>
                }
                <div class="d-flex justify-content-between mt-3">
                    <span class="fw-bold">Total</span>
                    <span class="fw-bold text-success fs-5">$@Model.Total.ToString("F2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
